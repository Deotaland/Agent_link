menu "Agent Link Device"

rsource "Kconfig.profiles"

config BOARD_TYPE_WAVESHARE_EPAPER_397_WIFI
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "waveshare-epaper-397-wifi"

config BOARD_TYPE_PAPER_S31_WIFI
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "paper-s31-wifi"

config PAPER_S31_DISPLAY_DIAGNOSTIC
    bool "S31: display one static diagnostic frame, then hold"
    depends on BOARD_TYPE_PAPER_S31_WIFI
    default n
    help
        Boot into a single white-background display test. After one attempt,
        including failure, no display writes or retries occur until reboot.
        Menu input and application timers are disabled; network setup/auth
        tasks remain running. Log frame statistics and display BUSY timings
        without changing the panel register values or adding busy waits.

config BOARD_TYPE_ROROLEE_S3
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "rorolee-ble"

config BOARD_TYPE_ESP32P4_WAVESHARE
    bool

config BOARD_TYPE_ESP32S3_ES8311_VOICE
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "es8311-voice-ble"

config BOARD_TYPE_ESP32S3_ES8311_ASR
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "es8311-asr-ble"

config BOARD_TYPE_ESP32S3_GC2145_CAMERA
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "gc2145-camera-ble"

config BOARD_TYPE_ESP32S3_KORVO
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "korvo-ble"

config BOARD_TYPE_ESP32S3_KORVO_CLOUD
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "korvo-wifi"
    select LV_FONT_MONTSERRAT_28
    select MBEDTLS_DYNAMIC_BUFFER
    select MBEDTLS_DYNAMIC_FREE_CONFIG_DATA
    select SPIRAM_TRY_ALLOCATE_WIFI_LWIP
    help
        The korvo-wifi profile provides the platform touch UI and realtime voice.
        Use korvo-ble for the phone App firmware on the same hardware.

config BOARD_TYPE_ESP32S3_WORK_BADGE
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "work-badge-ble"
    select LV_FONT_MONTSERRAT_20
    select LV_FONT_MONTSERRAT_28

config BOARD_TYPE_ROROLEE_MUSE
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "rorolee-muse"
    select LV_FONT_MONTSERRAT_20
    select LV_FONT_MONTSERRAT_28
    select LV_USE_TINY_TTF
    select SPIRAM_TRY_ALLOCATE_WIFI_LWIP
    help
        The rorolee-s3 PCB with an LVGL screen: link status, hold BOOT to talk, the
        answer as text. The rorolee-muse profile pairs through the Muse app.

config BOARD_TYPE_WOWNNY_MUSE
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "wownny-muse"
    select LV_FONT_MONTSERRAT_12
    select SPIRAM_TRY_ALLOCATE_WIFI_LWIP
    help
        WOWNNY: the rorolee PCB with a GC9D01 round TFT instead of the SH8501 AMOLED.
        Same features as RoRoLee Muse, with a UI for the round screen. Panel on GPIO4-7
        and GPIO43, backlight on GPIO46, 32.768 kHz crystal on GPIO15/16.

config BOARD_TYPE_WOWNNY_OLD_MUSE
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "wownny-old-muse"
    select LV_FONT_MONTSERRAT_12
    select SPIRAM_TRY_ALLOCATE_WIFI_LWIP
    help
        The old WOWNNY board, built from boards/wownny-muse like WWY-01. Differences:
        panel on GPIO4-7/15 and powered from GPIO46 (power-cycled at boot), no 32.768 kHz
        crystal (RTC on the internal RC), SD D3 on GPIO16, volume keys swapped.

config BOARD_TYPE_M5STACK_STOPWATCH
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "m5stack-stopwatch-ble"
    select LV_FONT_MONTSERRAT_20
    select LV_FONT_MONTSERRAT_24
    select LV_FONT_MONTSERRAT_28
    select LV_FONT_MONTSERRAT_48
    help
        M5Stack StopWatch (ESP32-S3R8, SKU C152): hold the yellow key to talk to the agent,
        replies on the speaker, the link status on the round screen.
        The supported profile is m5stack-stopwatch-ble.

config BOARD_TYPE_OJBADGE_WIFI
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "ojbadge-wifi"
    select LV_FONT_MONTSERRAT_20
    select LV_FONT_MONTSERRAT_28
    help
        OJBadge 240x240 circular touch UI and local ESP-NOW friendship.
        No platform startup, provisioning, cloud authentication or audio.

config BOARD_TYPE_WAVESHARE_AMOLED_175_WIFI
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "waveshare-amoled-175-wifi"
    select LV_FONT_MONTSERRAT_20
    select LV_FONT_MONTSERRAT_24
    select LV_FONT_MONTSERRAT_48
    select MBEDTLS_DYNAMIC_BUFFER
    select MBEDTLS_DYNAMIC_FREE_CONFIG_DATA
    select SPIRAM_TRY_ALLOCATE_WIFI_LWIP
    help
        Waveshare ESP32-S3-Touch-AMOLED-1.75C: circular touch UI, status ring,
        WiFi setup, activation and realtime voice with the platform-bound Agent.

config BOARD_TYPE_M5STACK_STOPWATCH_WIFI
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "m5stack-stopwatch-wifi"
    select LV_FONT_MONTSERRAT_20
    select LV_FONT_MONTSERRAT_24
    select LV_FONT_MONTSERRAT_28
    select LV_FONT_MONTSERRAT_48
    select MBEDTLS_DYNAMIC_BUFFER
    select MBEDTLS_DYNAMIC_FREE_CONFIG_DATA
    select SPIRAM_TRY_ALLOCATE_WIFI_LWIP
    help
        StopWatch WiFi: hotspot setup, activation code, platform-bound agent,
        conversation management and realtime voice. Use m5stack-stopwatch-ble for the phone App firmware.

config BOARD_TYPE_FOLOTOY_AI_PASSPORT
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "ai-passport-ble"
    help
        FoloToy AI Passport wearable: ESP32-C3, 8 MB flash, no PSRAM. Hold the OK key to
        talk to the agent over BLE; replies play on the speaker. Screen colour shows link
        status. Use the ai-passport-ble profile. Pins match FoloToy ai-passport BSP.

config BOARD_TYPE_FOLOTOY_AI_PASSPORT_WIFI
    bool
    default y if AGENT_LINK_FIRMWARE_PROFILE = "ai-passport-wifi"

config AGENT_LINK_TRANSPORT_BLE
    bool
    default y if BOARD_TYPE_ESP32S3_KORVO
    default y if BOARD_TYPE_ROROLEE_S3
    default y if BOARD_TYPE_ESP32S3_WORK_BADGE
    default y if BOARD_TYPE_FOLOTOY_AI_PASSPORT
    default y if BOARD_TYPE_M5STACK_STOPWATCH
    default y if BOARD_TYPE_ESP32S3_GC2145_CAMERA
    default y if BOARD_TYPE_ESP32S3_ES8311_VOICE
    default y if BOARD_TYPE_ESP32S3_ES8311_ASR

config AGENT_LINK_TRANSPORT_WIFI
    bool
    default y if BOARD_TYPE_FOLOTOY_AI_PASSPORT_WIFI
    default y if BOARD_TYPE_WAVESHARE_EPAPER_397_WIFI
    default y if BOARD_TYPE_PAPER_S31_WIFI
    default y if BOARD_TYPE_ESP32S3_KORVO_CLOUD
    default y if BOARD_TYPE_M5STACK_STOPWATCH_WIFI
    default y if BOARD_TYPE_WAVESHARE_AMOLED_175_WIFI

config AGENT_LINK_TRANSPORT_MUSE
    bool
    default y if BOARD_TYPE_ROROLEE_MUSE
    default y if BOARD_TYPE_WOWNNY_MUSE
    default y if BOARD_TYPE_WOWNNY_OLD_MUSE
    select MBEDTLS_HKDF_C

endmenu
