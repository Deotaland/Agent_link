CONFIG_AGENT_LINK_PROFILE_WAVESHARE_AMOLED_175_WIFI=y
# Multi-app installs are owned by the factory launcher, never round-robin OTA.
# CONFIG_AGENT_LINK_OTA_ENABLE is not set
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=26
CONFIG_LV_FONT_SIMSUN_14_CJK=y
CONFIG_LV_USE_TINY_TTF=y
# Covers are immutable RGB565+A8 snapshots read from app slot tails, without PNG/FS decoding.
# CONFIG_LV_USE_LODEPNG is not set
# CONFIG_LV_USE_FS_STDIO is not set
# Circular clipping layers and long CJK replies live in the external LVGL heap.
CONFIG_LV_MEM_SIZE_KILOBYTES=1536
