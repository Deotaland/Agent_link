CONFIG_AGENT_LINK_PROFILE_WAVESHARE_AMOLED_175_WIFI=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_RTC_CLK_SRC_INT_RC=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=26
CONFIG_LV_FONT_SIMSUN_14_CJK=y
CONFIG_LV_USE_TINY_TTF=y
# Circular clipping layers and long CJK replies live in the external LVGL heap.
CONFIG_LV_MEM_SIZE_KILOBYTES=1536
