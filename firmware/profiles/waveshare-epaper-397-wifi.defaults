CONFIG_AGENT_LINK_PROFILE_WAVESHARE_EPAPER_397_WIFI=y

# Hardware settings for this firmware profile.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_RTC_CLK_SRC_INT_RC=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=26
CONFIG_LV_FONT_SIMSUN_14_CJK=y
CONFIG_LV_USE_TINY_TTF=y
CONFIG_WAVESHARE_EPAPER_PRODUCT_ID=20
