CONFIG_AGENT_LINK_PROFILE_AI_PASSPORT_WIFI=y

# AI Passport hardware: 8 MB flash, no PSRAM; USB console avoids backlight GPIO21.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_esp32c3.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_esp32c3.csv"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_RTC_CLK_SRC_INT_RC=y
# Match the working Passport voice scheduler: one tick is 1 ms.
CONFIG_FREERTOS_HZ=1000

# Reserve the C3's internal RAM for verified HTTPS and Opus realtime WSS.
CONFIG_AGENT_LINK_MQTT_ENABLE=n
CONFIG_AGENT_LINK_REALTIME_OPUS=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# Fragment outbound application data into 1 KB TLS records. Keep the standard
# 16 KB inbound limit: it is selected by the peer, not by our audio packet size.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=1024
# Prefer heap headroom over bulk WiFi throughput. C3 shares the instruction/data
# SRAM budget; RX acceleration also competes with the full-size TLS record.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=4096
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_LWIP_TCP_RECVMBOX_SIZE=8
