# A single generated plan controls flash destinations and initial boot selection.
# Override IDF's first-app address for both installed and future/reserved Factory layouts.
file(READ "${CMAKE_BINARY_DIR}/flash-plan.json" _flash_plan)
string(JSON _flash_mode GET "${_flash_plan}" mode)
string(JSON _reserved_factory ERROR_VARIABLE _factory_error GET "${_flash_plan}" partitions factory size)
if(_flash_mode STREQUAL "managed" OR NOT _factory_error)
    string(JSON _app_offset GET "${_flash_plan}" app_offset)
    string(JSON _boot_offset GET "${_flash_plan}" otadata_offset)
    math(EXPR _app_offset "${_app_offset}" OUTPUT_FORMAT HEXADECIMAL)
    math(EXPR _boot_offset "${_boot_offset}" OUTPUT_FORMAT HEXADECIMAL)
    function(agent_link_remove_flash_file target filename)
        if(NOT TARGET ${target})
            return()
        endif()
        foreach(property IMAGES FLASH_FILE FLASH_ENTRY ENCRYPTED_IMAGES NON_ENCRYPTED_IMAGES)
            get_property(entries TARGET ${target} PROPERTY ${property})
            set(kept "")
            foreach(entry IN LISTS entries)
                string(FIND "${entry}" "${filename}" found)
                if(found EQUAL -1)
                    list(APPEND kept "${entry}")
                endif()
            endforeach()
            set_property(TARGET ${target} PROPERTY ${property} "${kept}")
        endforeach()
    endfunction()
    idf_build_get_property(_idf_project_bin PROJECT_BIN)
    foreach(_target flash app-flash)
        # IDF 6 uses a generator expression for PROJECT_BIN, so match that
        # expression as well as the literal filename used by IDF 5.
        foreach(_file "${_idf_project_bin}" agent_link.bin ota_data_initial.bin)
            agent_link_remove_flash_file(${_target} "${_file}")
            agent_link_remove_flash_file(encrypted-${_target} "${_file}")
        endforeach()
        esptool_py_flash_target_image(${_target} app "${_app_offset}" "${CMAKE_BINARY_DIR}/agent_link.bin")
        esptool_py_flash_target_image(${_target} otadata "${_boot_offset}" "${CMAKE_BINARY_DIR}/boot-selection.bin")
    endforeach()
endif()
string(JSON _dynamic_guard ERROR_VARIABLE _dynamic_error GET "${_flash_plan}" dynamic_slots guard_partition)
if(NOT _dynamic_error)
    set(_guard_output "${CMAKE_BINARY_DIR}/flash_assets/${_dynamic_guard}.bin")
    idf_build_get_property(_python PYTHON)
    execute_process(COMMAND "${_python}" "${CMAKE_CURRENT_LIST_DIR}/../tools/dynamic_layout.py"
        --profile "${AGENT_LINK_PROFILE}" --reset "${_guard_output}"
        RESULT_VARIABLE _guard_result ERROR_VARIABLE _guard_error)
    if(NOT _guard_result EQUAL 0)
        message(FATAL_ERROR "${_guard_error}")
    endif()
    esptool_py_flash_to_partition(flash "${_dynamic_guard}" "${_guard_output}")
endif()
string(JSON _asset_count ERROR_VARIABLE _asset_error LENGTH "${_profile}" flash_assets)
if(_asset_error OR _asset_count EQUAL 0)
    return()
endif()
math(EXPR _asset_last "${_asset_count} - 1")
idf_build_get_property(_asset_build_dir BUILD_DIR)
foreach(_index RANGE ${_asset_last})
    string(JSON _asset_partition GET "${_profile}" flash_assets ${_index} partition)
    string(JSON _asset_file GET "${_profile}" flash_assets ${_index} file)
    set(_asset_source "${CMAKE_CURRENT_LIST_DIR}/../${_asset_file}")
    partition_table_get_partition_info(_asset_size "--partition-name ${_asset_partition}" "size")
    if(NOT _asset_size)
        message(FATAL_ERROR "Missing data partition for ${_asset_partition}")
    endif()
    file(SIZE "${_asset_source}" _asset_bytes)
    if(_asset_bytes GREATER _asset_size)
        message(FATAL_ERROR "Flash asset ${_asset_file} exceeds partition ${_asset_partition}")
    endif()
    set(_asset_output "${_asset_build_dir}/flash_assets/${_asset_partition}.bin")
    configure_file("${_asset_source}" "${_asset_output}" COPYONLY)
    esptool_py_flash_to_partition(flash "${_asset_partition}" "${_asset_output}")
endforeach()
