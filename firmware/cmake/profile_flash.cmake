# Optional data images belong to the selected profile, including normal idf.py flash.
string(JSON _asset_count ERROR_VARIABLE _asset_error LENGTH "${_profile}" flash_assets)
if(_asset_error OR _asset_count EQUAL 0)
    return()
endif()
math(EXPR _asset_last "${_asset_count} - 1")
idf_build_get_property(_asset_build_dir BUILD_DIR)
foreach(_index RANGE ${_asset_last})
    string(JSON _asset_partition GET "${_profile}" flash_assets ${_index} partition)
    string(JSON _asset_file GET "${_profile}" flash_assets ${_index} file)
    set(_asset_source "${CMAKE_CURRENT_LIST_DIR}/../${_asset_file}")
    partition_table_get_partition_info(_asset_size "--partition-name ${_asset_partition}" "size")
    if(NOT _asset_size)
        message(FATAL_ERROR "Missing data partition for ${_asset_partition}")
    endif()
    file(SIZE "${_asset_source}" _asset_bytes)
    if(_asset_bytes GREATER _asset_size)
        message(FATAL_ERROR "Flash asset ${_asset_file} exceeds partition ${_asset_partition}")
    endif()
    set(_asset_output "${_asset_build_dir}/flash_assets/${_asset_partition}.bin")
    configure_file("${_asset_source}" "${_asset_output}" COPYONLY)
    esptool_py_flash_to_partition(flash "${_asset_partition}" "${_asset_output}")
endforeach()
