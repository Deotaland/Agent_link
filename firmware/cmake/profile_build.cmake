# Read before sdkconfig is available, including ESP-IDF's dependency expansion pass.
if(NOT DEFINED ENV{AGENT_LINK_PROFILE_FILE} OR NOT DEFINED ENV{AGENT_LINK_BUILD_PROFILE})
    message(FATAL_ERROR "Configure through the firmware root or tools/build_firmware.py")
endif()
file(READ "$ENV{AGENT_LINK_PROFILE_FILE}" _build_profiles)
string(JSON BUILD_PROFILE GET "${_build_profiles}" "$ENV{AGENT_LINK_BUILD_PROFILE}")
set(FIRMWARE_ROOT "$ENV{AGENT_LINK_FIRMWARE_ROOT}")
foreach(_field board app hardware backend ui)
    string(JSON PROFILE_${_field} GET "${BUILD_PROFILE}" ${_field})
endforeach()
string(JSON PROFILE_app_shared ERROR_VARIABLE _shared_error GET "${BUILD_PROFILE}" app_shared)
if(_shared_error)
    set(PROFILE_app_shared "")
endif()
foreach(_field factory ui_component)
    string(JSON PROFILE_${_field} ERROR_VARIABLE _optional_error GET "${BUILD_PROFILE}" ${_field})
    if(_optional_error)
        set(PROFILE_${_field} "")
    endif()
endforeach()
if(NOT PROFILE_factory STREQUAL "")
    if(NOT DEFINED AGENT_LINK_IMAGE_ROLE OR AGENT_LINK_IMAGE_ROLE STREQUAL "")
        set(AGENT_LINK_IMAGE_ROLE "$ENV{AGENT_LINK_IMAGE_ROLE}")
    endif()
    set(_manifest "${FIRMWARE_ROOT}/factory/${PROFILE_factory}/manifest.json")
    string(JSON SYSTEM_MANIFEST GET "${BUILD_PROFILE}" system)
    string(JSON SYSTEM_IMAGE GET "${SYSTEM_MANIFEST}" images "${AGENT_LINK_IMAGE_ROLE}")
    foreach(_field path app_id name shared_app)
        string(JSON IMAGE_${_field} GET "${SYSTEM_IMAGE}" ${_field})
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest}")
endif()
function(image_list output field)
    string(JSON _count LENGTH "${SYSTEM_IMAGE}" ${field})
    set(_values "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_i RANGE ${_last})
            string(JSON _value GET "${SYSTEM_IMAGE}" ${field} ${_i})
            list(APPEND _values "${_value}")
        endforeach()
    endif()
    set(${output} "${_values}" PARENT_SCOPE)
endfunction()
function(profile_list output field)
    string(JSON _count LENGTH "${BUILD_PROFILE}" ${field})
    set(_values "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_i RANGE ${_last})
            string(JSON _value GET "${BUILD_PROFILE}" ${field} ${_i})
            list(APPEND _values "${_value}")
        endforeach()
    endif()
    set(${output} "${_values}" PARENT_SCOPE)
endfunction()
