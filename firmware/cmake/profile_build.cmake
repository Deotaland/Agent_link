# Read before sdkconfig is available, including ESP-IDF's dependency expansion pass.
if(NOT DEFINED ENV{AGENT_LINK_PROFILE_FILE} OR NOT DEFINED ENV{AGENT_LINK_BUILD_PROFILE})
    message(FATAL_ERROR "Configure through the firmware root or tools/build_firmware.py")
endif()
file(READ "$ENV{AGENT_LINK_PROFILE_FILE}" _build_profiles)
string(JSON BUILD_PROFILE GET "${_build_profiles}" "$ENV{AGENT_LINK_BUILD_PROFILE}")
get_filename_component(FIRMWARE_ROOT "$ENV{AGENT_LINK_PROFILE_FILE}" DIRECTORY)
get_filename_component(FIRMWARE_ROOT "${FIRMWARE_ROOT}" DIRECTORY)
foreach(_field board app hardware backend ui)
    string(JSON PROFILE_${_field} GET "${BUILD_PROFILE}" ${_field})
endforeach()
function(profile_list output field)
    string(JSON _count LENGTH "${BUILD_PROFILE}" ${field})
    set(_values "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_i RANGE ${_last})
            string(JSON _value GET "${BUILD_PROFILE}" ${field} ${_i})
            list(APPEND _values "${_value}")
        endforeach()
    endif()
    set(${output} "${_values}" PARENT_SCOPE)
endfunction()
