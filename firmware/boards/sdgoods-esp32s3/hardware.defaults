# Physical SDGOODS ESP32-S3 hardware, verified with the vendor BSP.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
# sdgoods-v2 keeps all executable images and mmap assets below 16 MB.
# CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH is not set
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_RTC_CLK_SRC_INT_RC=y
