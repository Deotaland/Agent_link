# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Binary assets: never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.bin  binary
*.a    binary
*.ttf  binary

# Keep the pinned upstream license verbatim, including its final blank line.
firmware/components/webp_decoder/third_party/COPYING whitespace=-blank-at-eof
